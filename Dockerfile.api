FROM golang:1.24.11-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN /usr/local/go/bin/go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 /usr/local/go/bin/go build -trimpath -ldflags='-s -w' -o /out/pantry-api ./cmd/pantry-api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/pantry-api /pantry-api
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/pantry-api"]
