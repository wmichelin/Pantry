FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG EXPO_PUBLIC_SUPABASE_URL
ARG EXPO_PUBLIC_SUPABASE_ANON_KEY
ARG EXPO_PUBLIC_PANTRY_API_URL
ARG EXPO_PUBLIC_PANTRY_API_TRANSPORT
ARG EXPO_PUBLIC_PANTRY_API_RECIPE_WRITES
ARG EXPO_PUBLIC_PANTRY_API_RECIPE_IMPORTS
ARG EXPO_PUBLIC_PANTRY_API_RECIPE_MANAGEMENT
ARG EXPO_PUBLIC_PANTRY_API_QUEUE
ARG EXPO_PUBLIC_PANTRY_API_SHOPPING_CHECKS
ARG EXPO_PUBLIC_PANTRY_API_SHOPPING_LIST
ENV EXPO_PUBLIC_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL
ENV EXPO_PUBLIC_SUPABASE_ANON_KEY=$EXPO_PUBLIC_SUPABASE_ANON_KEY
ENV EXPO_PUBLIC_PANTRY_API_URL=$EXPO_PUBLIC_PANTRY_API_URL
ENV EXPO_PUBLIC_PANTRY_API_TRANSPORT=$EXPO_PUBLIC_PANTRY_API_TRANSPORT
ENV EXPO_PUBLIC_PANTRY_API_RECIPE_WRITES=$EXPO_PUBLIC_PANTRY_API_RECIPE_WRITES
ENV EXPO_PUBLIC_PANTRY_API_RECIPE_IMPORTS=$EXPO_PUBLIC_PANTRY_API_RECIPE_IMPORTS
ENV EXPO_PUBLIC_PANTRY_API_RECIPE_MANAGEMENT=$EXPO_PUBLIC_PANTRY_API_RECIPE_MANAGEMENT
ENV EXPO_PUBLIC_PANTRY_API_QUEUE=$EXPO_PUBLIC_PANTRY_API_QUEUE
ENV EXPO_PUBLIC_PANTRY_API_SHOPPING_CHECKS=$EXPO_PUBLIC_PANTRY_API_SHOPPING_CHECKS
ENV EXPO_PUBLIC_PANTRY_API_SHOPPING_LIST=$EXPO_PUBLIC_PANTRY_API_SHOPPING_LIST
RUN npx expo export --platform web

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
