# Pantry nightly Postgres backup (UTC). Install on the DigitalOcean droplet:
#   sudo cp scripts/pantry-backup.cron /etc/cron.d/pantry-backup
#   sudo chmod 644 /etc/cron.d/pantry-backup
# This file contains no secrets. The root-only systemd service loads credentials
# into the dedicated pantry-backup identity at runtime. Install only after the
# manual backup, alert, and isolated scratch-restore gates pass.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# min hour dom mon dow user  command
0 3 * * * root /usr/bin/systemctl start --wait pantry-backup.service
